diff --git a/megatron/core/transformer/dot_product_attention.py b/megatron/core/transformer/dot_product_attention.py
index 69039e0bf..fec44b832 100644
--- a/megatron/core/transformer/dot_product_attention.py
+++ b/megatron/core/transformer/dot_product_attention.py
@@ -269,3 +269,85 @@ class DotProductAttention(MegatronModule):
             tp_group=self.tp_group,
             dp_cp_group=metadata['dp_cp_group'],
         )
+
+
+try:
+    from flash_attn_3.flash_attn_interface import flash_attn_3_gpu as _fa3_gpu
+    HAVE_FA3 = True
+except ImportError:
+    try:
+        from flashattn_hopper.flash_attn_interface import flash_attn_3_gpu as _fa3_gpu
+        HAVE_FA3 = True
+    except ImportError:
+        _fa3_gpu = None
+        HAVE_FA3 = False
+
+
+class _FA3Func(torch.autograd.Function):
+    """Direct FA3 forward/backward bypassing torch.library.custom_op mutates_args."""
+
+    @staticmethod
+    def forward(ctx, q, k, v, softmax_scale, causal):
+        out, softmax_lse, _, _ = _fa3_gpu.fwd(
+            q, k, v,
+            None, None, None, None,
+            None, None, None,
+            None, None,
+            None, None,
+            None, None, None,
+            None, None, None,
+            None, None, None,
+            softmax_scale, causal,
+            -1, -1, 0, 0.0, False, None, 1, None, 0,
+        )
+        ctx.save_for_backward(q, k, v, out, softmax_lse)
+        ctx.softmax_scale = softmax_scale
+        ctx.causal = causal
+        return out
+
+    @staticmethod
+    def backward(ctx, dout):
+        q, k, v, out, softmax_lse = ctx.saved_tensors
+        dq, dk, dv = torch.empty_like(q), torch.empty_like(k), torch.empty_like(v)
+        _fa3_gpu.bwd(
+            dout.contiguous(), q, k, v, out, softmax_lse,
+            dq, dk, dv,
+            None, None, None, None, None, None,
+            ctx.softmax_scale, ctx.causal, -1, -1, 0.0, False, 0,
+        )
+        return dq, dk, dv, None, None
+
+
+class FA3DotProductAttention(DotProductAttention):
+    """FlashAttention 3 — SM90 TMA/WGMMA fused attention, GQA-native."""
+
+    def forward(
+        self,
+        query: Tensor,
+        key: Tensor,
+        value: Tensor,
+        attention_mask,
+        attn_mask_type=None,
+        attention_bias=None,
+        packed_seq_params=None,
+    ) -> Tensor:
+        assert packed_seq_params is None, (
+            "Packed sequence is not supported by FA3DotProductAttention."
+        )
+        assert attention_bias is None, (
+            "Attention bias is not supported by FA3DotProductAttention."
+        )
+        if not HAVE_FA3:
+            raise ImportError(
+                "FlashAttention 3 is not installed but --use-flash-attention-v3 was requested. "
+                "Install flash_attn_3 or flashattn_hopper inside the container."
+            )
+        # Megatron layout: sbhd [sq, b, np, hn]
+        # FA3 expects:     bshd [b, sq, np, hn]
+        q = query.permute(1, 0, 2, 3).contiguous()
+        k = key.permute(1, 0, 2, 3).contiguous()
+        v = value.permute(1, 0, 2, 3).contiguous()
+        out = _FA3Func.apply(q, k, v, self.softmax_scale, True)
+        # [b, sq, np, hn] -> [sq, b, hp]
+        out = out.permute(1, 0, 2, 3)
+        return out.reshape(out.size(0), out.size(1), -1)
