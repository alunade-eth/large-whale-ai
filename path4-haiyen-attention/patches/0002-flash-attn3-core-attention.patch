+
+
+class FA3DotProductAttention(MegatronModule):
+    """Core attention using FlashAttention 3.
+
+    Drop-in replacement for TEDotProductAttention that calls the FA3 kernel
+    directly. Accepts Megatron's sbhd tensor layout, converts to FA3's bshd,
+    runs the fused kernel, then converts back.
+
+    Supports causal masking and GQA. Packed-sequence (thd) format and
+    attention bias are not supported; assert if attempted.
+    """
+
+    def __init__(
+        self,
+        config: TransformerConfig,
+        layer_number: int,
+        attn_mask_type: AttnMaskType,
+        attention_type: str,
+        attention_dropout: Optional[float] = None,
+        softmax_scale: Optional[float] = None,
+        cp_comm_type: Optional[str] = None,
+        pg_collection: Optional[ProcessGroupCollection] = None,
+        **kwargs,
+    ):
+        super().__init__(config=config)
+
+        if not HAVE_FA3_TRAINING:
+            raise ImportError(
+                "FlashAttention 3 is not installed. "
+                "Install flash_attn_3 or flashattn_hopper to use --use-flash-attention-v3."
+            )
+
+        self.config = config
+        self.attn_mask_type = attn_mask_type
+
+        world_size = parallel_state.get_tensor_model_parallel_world_size()
+        self.hidden_size_per_attention_head = config.kv_channels
+        self.num_attention_heads_per_partition = divide(config.num_attention_heads, world_size)
+        self.num_query_groups_per_partition = divide(config.num_query_groups, world_size)
+        self.hidden_size_per_partition = (
+            self.hidden_size_per_attention_head * self.num_attention_heads_per_partition
+        )
+
+        if softmax_scale is None:
+            self.softmax_scale = 1.0 / math.sqrt(self.hidden_size_per_attention_head)
+        else:
+            self.softmax_scale = softmax_scale
+
+        self.dropout_p = (
+            config.attention_dropout if attention_dropout is None else attention_dropout
+        )
+
+    def forward(
+        self,
+        query: Tensor,
+        key: Tensor,
+        value: Tensor,
+        attention_mask: Optional[Tensor],
+        attn_mask_type: Optional[AttnMaskType] = None,
+        attention_bias: Optional[Tensor] = None,
+        packed_seq_params: Optional[PackedSeqParams] = None,
+        **kwargs,
+    ) -> Tensor:
+        """Forward pass using FlashAttention 3.
+
+        Args:
+            query: [sq, b, np, hn]  Megatron sbhd layout
+            key:   [sk, b, ng, hn]
+            value: [sk, b, ng, hn]
+
+        Returns:
+            context: [sq, b, np*hn]
+        """
+        assert packed_seq_params is None, (
+            "Packed sequences (thd format) are not supported by FA3DotProductAttention."
+        )
+        assert attention_bias is None, (
+            "Attention bias is not supported by FA3DotProductAttention."
+        )
+
+        sq, b, np, hn = query.shape
+
+        # sbhd -> bshd: permute() is zero-copy (only reorders strides).
+        # FA3 uses maybe_contiguous() internally and only copies when stride(-1) != 1.
+        # Swapping dims 0 and 1 leaves the headdim stride at 1, so no copy occurs.
+        q = query.permute(1, 0, 2, 3)
+        k = key.permute(1, 0, 2, 3)
+        v = value.permute(1, 0, 2, 3)
+
+        _mask_type = attn_mask_type if attn_mask_type is not None else self.attn_mask_type
+        causal = _mask_type in (AttnMaskType.causal, AttnMaskType.padding_causal)
+
+        dropout_p = self.dropout_p if self.training else 0.0
+
+        output = _fa3_flash_attn_func(
+            q, k, v,
+            dropout_p=dropout_p,
+            softmax_scale=self.softmax_scale,
+            causal=causal,
+        )
+
+        # bshd -> sbhd, flatten heads: [sq, b, np*hn].
+        # view() folds np*hn into hp (zero-copy on the contiguous FA3 output).
+        # transpose() swaps batch and seq back (zero-copy).
+        # One contiguous() copy produces the layout TERowParallelLinear expects.
+        output = output.view(b, sq, -1).transpose(0, 1).contiguous()
+
+        return output
