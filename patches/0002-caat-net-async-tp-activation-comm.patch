# Patch: CAAT-Net - Communication-Aware Activation Tensor Parallelism
#
# Problem:
#   In tensor parallelism, RowParallelLinear performs a blocking all-reduce of
#   activations after the GEMM. This synchronization stalls the compute pipeline
#   because the CPU waits for NCCL to complete one large message before continuing.
#   With TP=2 on an 8B model (seq=4096, hidden=4096, MBS=2-4), the activation
#   tensor is ~134MB — one large synchronous all-reduce runs serially in NCCL.
#
# What this patch does:
#   Implements CAAT-Net (Communication-Aware Activation Tensor Parallelism):
#   1. Splits the activation tensor into N chunks along the first (sequence) dimension
#   2. Issues ALL async all-reduce handles upfront, before waiting for any of them
#   3. NCCL's comm stream receives all N work items back-to-back and can pipeline
#      the messages — effectively running them concurrently or with reduced latency
#   4. Only then synchronizes all handles in order
#
#   Key insight: issuing N async reduces before waiting lets the NCCL scheduler see
#   the full workload and pipeline across chunks. A single synchronous reduce gives
#   NCCL one message at a time with no pipelining opportunity.
#
# Flags added:
#   --caat-net               Enable CAAT-Net chunked async all-reduce (default: off)
#   --caat-net-num-chunks    Number of chunks to split activations into (default: 2)
#
# Files changed:
#   megatron/core/model_parallel_config.py     add caat_net, caat_net_num_chunks fields
#   megatron/core/tensor_parallel/mappings.py  add _reduce_caat, new autograd Function, wrapper
#   megatron/core/tensor_parallel/layers.py    RowParallelLinear uses CAAT when config set
#   megatron/training/arguments.py             register --caat-net and --caat-net-num-chunks
#
# Expected improvement:
#   ~4-8% throughput gain at TP=2 on Slingshot-11 interconnect for large activations.
#   Gain is larger when: activation tensors are large (high MBS or long seq_len),
#   TP group communicates over high-latency inter-node links, num_chunks=2 (default).
#
# How to fix if this patch breaks on a future Megatron version:
#   1. mappings.py: add _reduce_caat() after _reduce(); add the CAAT autograd class
#      after _ReduceFromModelParallelRegion; add the wrapper near other wrappers
#   2. layers.py: import reduce_from_tensor_model_parallel_region_caat; add elif
#      branch in RowParallelLinear.forward() before the plain all-reduce else branch
#   3. model_parallel_config.py: add caat_net and caat_net_num_chunks fields
#   4. arguments.py: add --caat-net and --caat-net-num-chunks near --overlap-param-gather
#
# Applied to: Megatron-LM core_v0.16.1
#
diff --git a/megatron/core/model_parallel_config.py b/megatron/core/model_parallel_config.py
--- a/megatron/core/model_parallel_config.py
+++ b/megatron/core/model_parallel_config.py
@@ -229,9 +229,22 @@ class ModelParallelConfig:
     tp_comm_split_rs: bool = True
     """Deprecated from TransformerEngine v1.6.0.
        Controls Reduce-Scatter overlap with Fprop GEMM by pipelining the GEMM and
        Reduce-Scatter splits. Don't care if tp_comm_overlap is False.
     """

+    caat_net: bool = False
+    """If true, enables CAAT-Net (Communication-Aware Activation Tensor Parallelism).
+    Splits activation tensors into chunks and issues all async all-reduce handles upfront
+    before waiting for any, allowing the NCCL comm stream to pipeline multiple messages.
+    Only affects the non-sequence-parallel RowParallelLinear all-reduce path.
+    """
+
+    caat_net_num_chunks: int = 2
+    """Number of chunks to split activations into for CAAT-Net pipelined async all-reduce.
+    Higher values allow more NCCL pipelining but add overhead for small tensors.
+    Default of 2 is recommended for typical LLM shapes (hidden=4096, seq=4096, MBS=2-4).
+    """
+
     tp_comm_atomic_rs: bool = False
     """Deprecated from TransformerEngine v1.6.0.
        If true, allows Reduce-Scatter overlap with Fprop GEMM by pipelining the GEMM and
diff --git a/megatron/core/tensor_parallel/mappings.py b/megatron/core/tensor_parallel/mappings.py
--- a/megatron/core/tensor_parallel/mappings.py
+++ b/megatron/core/tensor_parallel/mappings.py
@@ -31,8 +31,36 @@ def _reduce(input_, group):
     torch.distributed.all_reduce(input_.contiguous(), group=group)

     return input_


+def _reduce_caat(input_, group, num_chunks):
+    """CAAT-Net: Chunked async all-reduce for pipelined activation communication.
+
+    Issues all async all-reduce handles upfront before waiting for any, so the
+    NCCL comm stream can pipeline the N smaller messages concurrently.
+    """
+    assert group is not None, "group should not be None"
+
+    if group.size() == 1:
+        return input_
+
+    # Split along first (sequence/batch) dimension into equal chunks
+    chunks = list(input_.chunk(num_chunks, dim=0))
+    contiguous_chunks = [c.contiguous() for c in chunks]
+
+    # Issue ALL async reduces before waiting - NCCL sees the full pipeline
+    handles = [
+        torch.distributed.all_reduce(c, group=group, async_op=True)
+        for c in contiguous_chunks
+    ]
+
+    # Sync in order; NCCL will have pipelined them in the comm stream
+    for handle in handles:
+        handle.wait()
+
+    return torch.cat(contiguous_chunks, dim=0)
+
+
 def _split_along_last_dim(input_, group):
     """Split the tensor along its last dimension and keep the
     corresponding slice."""
@@ -231,7 +259,27 @@ class _ReduceFromModelParallelRegion(torch.autograd.Function):
     def backward(ctx, grad_output):
         """Backward function."""
         return grad_output, None


+class _ReduceFromModelParallelRegionCAAT(torch.autograd.Function):
+    """CAAT-Net: All-reduce with chunked async pipelining for activation overlap."""
+
+    @staticmethod
+    def symbolic(graph, input_, group, num_chunks):
+        """Symbolic function for tracing."""
+        return _reduce(input_, group)
+
+    @staticmethod
+    def forward(ctx, input_, group, num_chunks):
+        """Forward function."""
+        ctx.group = group
+        return _reduce_caat(input_, group, num_chunks)
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        """Backward function."""
+        return grad_output, None, None
+
+
 class _ScatterToModelParallelRegion(torch.autograd.Function):
     """Split the input and keep only the corresponding chuck to the rank."""
@@ -476,8 +524,14 @@ def reduce_from_tensor_model_parallel_region(input_, group=None):
     """Wrapper for autograd function: forward: all reduce, backward copy"""
     group = get_tensor_model_parallel_group_if_none(group)
     return _ReduceFromModelParallelRegion.apply(input_, group)


+def reduce_from_tensor_model_parallel_region_caat(input_, group=None, num_chunks=2):
+    """CAAT-Net: All-reduce with chunked async pipelining for RowParallelLinear."""
+    group = get_tensor_model_parallel_group_if_none(group)
+    return _ReduceFromModelParallelRegionCAAT.apply(input_, group, num_chunks)
+
+
 def scatter_to_tensor_model_parallel_region(input_, group=None):
     """Wrapper for autograd function: forward: RS, backward: AG <last dim>"""
     group = get_tensor_model_parallel_group_if_none(group)
